# Backend only. Never use VITE_ or NEXT_PUBLIC_ for these values.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
# Set this only when the frontend is hosted separately from the Render backend.
VITE_API_BASE_URL=
PORT=3001
ADMIN_EMAIL=
# Minimum 14 characters. Bootstrap only; removing the env value does not remove the account.
ADMIN_PASSWORD=
COMPANY_ID=primary
DATABASE_PATH=data/investor.sqlite
# Production required: 32 random bytes encoded as 64 hexadecimal characters.
DATA_ENCRYPTION_KEY=
# Set only behind your trusted single reverse proxy.
TRUST_PROXY=0
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
AI_APPROVED_HOSTS=integrate.api.nvidia.com
# synthetic-only by default. Use approved-private only after enterprise privacy review.
AI_DATA_POLICY=synthetic-only
# Operator-provisioned read-only JSON adapter. The remote GET returns {records:[...]}.
# Browser users cannot supply endpoints or credentials.
CONNECTOR_CONFIG_JSON={}
# Example shape (set with your own authorized HTTPS endpoint):
# {"accounting":{"companyId":"primary","name":"Accounting API","kind":"Accounting","url":"https://your-approved-host/export","tokenEnv":"ACCOUNTING_READ_TOKEN"}}
ACCOUNTING_READ_TOKEN=
